{
  "name": "ckd-admin",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-04",
  "keep_vars": true,
  "assets": {
    "directory": "./worker/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "GITHUB_REPO": "suwardhan/art-posters-site",
    "GITHUB_BRANCH": "main",
    "ALLOWED_GITHUB_USERS": "suwardhan"
  }
}
